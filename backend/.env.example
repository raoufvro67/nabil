# PostgreSQL connection string (fourni automatiquement par Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT — génère une chaîne aléatoire longue (ex: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-secret

# Identifiants admin
ADMIN_USER=nabil
ADMIN_PASS=change-this-admin-password

# URL publique du backend (Railway la fournit)
BACKEND_URL=https://ton-app.railway.app

# Origines autorisées pour le CORS (domaine Vercel + domaine custom)
ALLOWED_ORIGINS=https://madrasti.vercel.app,https://madrasti.dz

# Port (Railway injecte automatiquement)
PORT=3000
