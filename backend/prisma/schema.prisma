generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Course {
  id        String   @id @default(cuid())
  title     String
  level     String
  type      String
  teacher   String
  subject   String
  trimestre String   @default("T1")
  videoUrl  String?
  pdfUrl    String?
  createdAt DateTime @default(now())
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  plan             String    @default("free")
  trimestre        String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
